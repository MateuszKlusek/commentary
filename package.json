{
    "name": "@commentary/repository",
    "private": true,
    "version": "0.1.0",
    "workspaces": [
        "app",
        "server"
    ],
    "types": "shared/types",
    "scripts": {
        "dev": "concurrently \"pnpm --filter @commentary/server dev\" \"pnpm --filter @commentary/app dev\"",
        "start-server": "pnpm --filter server start",
        "start-app": "pnpm --filter app dev",
        "build": "pnpm -r build"
    },
    "devDependencies": {
        "typescript": "^5.2.0",
        "concurrently": "^9.1.0"
    }
}